# Firebase Admin Credentials
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQ...\n-----END PRIVATE KEY-----\n"

# Gemini API Key (for parsing/matching emails)
GEMINI_API_KEY=your-gemini-api-key

# Google OAuth 2.0 Credentials (for Gmail Sync access)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth

# Application Security
# If configured, API requests must include headers: Authorization: Bearer your-custom-secret-token
WEBAPP_JOBS_TOKEN=your-custom-secret-token
FRONTEND_URL=http://localhost:5173
